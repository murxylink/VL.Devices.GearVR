          <Pad Id="KEoIZSbzesVMqznKs49fZ4" Bounds="12,66,455,132" ShowValueBox="true" isIOBox="true" Value="Gravity Response Seconds — Time in seconds used to smooth the gravity estimate. Higher values make gravity and linear acceleration more stable but slower to react; lower values react faster but may become noisier.&#xA;&#xA;Orientation Correction — Strength of accelerometer-based pitch and roll correction. Higher values return orientation to the gravity reference faster; lower values feel smoother but allow more drift. This does not correct yaw.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
